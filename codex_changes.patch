+def _interleave_sorted_groups(items: List[Dict[str, Any]], key: str) -> List[Dict[str, Any]]:
+    groups: Dict[Any, List[Dict[str, Any]]] = {}
+    for item in items:
+        groups.setdefault(item.get(key), []).append(item)
+    out: List[Dict[str, Any]] = []
