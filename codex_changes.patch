+        out = (out - mean) * contrast + mean
+        out = out * brightness
+        out = out.clamp(0.0, 1.0).pow(gamma)
+        if noise_std > 0.0:
+            noise = torch.from_numpy(rng.normal(0.0, noise_std, size=tuple(out.shape)).astype(np.float32))
+            out = out + noise
+        return out.clamp(0.0, 1.0)
