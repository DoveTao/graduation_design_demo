    "external_baselines/results/*/unmatched_or_skipped_pairs.jsonl"
  ],
  "safe_to_ignore_candidates": [
    "__pycache__/",
    "logs/",
    "outputs/",
    "reports_curated/",
    "backup_patches/"
  ]
}
